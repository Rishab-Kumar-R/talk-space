# Copy this file to .env and fill in the values before running the server.
# Never commit the actual .env file.

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# AWS S3 file uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# OAuth2 — Google (console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google  (dev)
#                          https://yourdomain.com/login/oauth2/code/google  (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 — GitHub (github.com/settings/developers → OAuth Apps)
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github  (dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the backend redirects the browser after successful OAuth login
# Dev: http://localhost:3000  |  Docker with Nginx: http://localhost
OAUTH2_FRONTEND_URL=http://localhost:3000

# Optional overrides (defaults shown)
# SERVER_PORT=8080
# JWT_EXPIRATION=86400000
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_DATABASE=chat_db
# REDIS_HOST=localhost
# REDIS_PORT=6379
# ALLOWED_ORIGIN=http://localhost:3000
